{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "PinApp",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define=API_BASE_URL=https://jsonplaceholder.typicode.com"
            ]
        },
        {
            "name": "PinApp (custom API)",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define=API_BASE_URL=https://custom-api.com"
            ]
        },
        {
            "name": "PinApp (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": [
                "--dart-define=API_BASE_URL=https://jsonplaceholder.typicode.com"
            ]
        },
        {
            "name": "PinApp (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": [
                "--dart-define=API_BASE_URL=https://jsonplaceholder.typicode.com"
            ]
        }
    ]
}